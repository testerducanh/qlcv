{
  "color": {
    "brand": {
      "primary": "#112723",
      "primary-hover": "#1c3a34",
      "primary-active": "#0a1815"
    },
    "surface": { "base": "#f8fafc", "raised": "#ffffff", "muted": "#eef1f5" },
    "text": {
      "primary": "#0f172a",
      "secondary": "#475569",
      "inverse": "#ffffff"
    },
    "border": { "default": "#eef1f5", "strong": "#64748b" },
