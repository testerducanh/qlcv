      "danger": "#b91c1c",
      "warning": "#b45309",
      "success": "#15803d",
      "info": "#1d4ed8"
    }
  },
  "font": {
    "family": {
      "base": "system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
    },
    "size": {
      "xs": "12px",
      "sm": "13px",
      "md": "14px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "24px"
    },
    "weight": { "regular": "400", "medium": "600", "bold": "700" },
    "line-height": { "tight": "1.25", "base": "1.5" }
  },
  "space": {
    "1": "1px",
    "2": "2px",
    "3": "3px",
    "4": "4px",
    "5": "5px",
    "6": "6px",
    "7": "7px",
    "8": "8px",
