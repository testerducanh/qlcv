model Comment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String    @map("task_id") @db.Uuid
  authorId   String    @map("author_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  body       String
  isQuestion Boolean   @default(false) @map("is_question")
  editedAt   DateTime? @map("edited_at") @db.Timestamptz(3)
  hiddenAt   DateTime? @map("hidden_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent      Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]    @relation("CommentReplies")
  mentions    Mention[]
  attachments Attachment[]

  @@index([taskId, createdAt])
  @@index([parentId])
  @@index([authorId])
  @@map("comment")
}

model Mention {
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("mention")
}

model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Loại thông báo (chuỗi, để thêm loại mới không cần migration), ví dụ task_assigned, mentioned.
  type       String
  dedupeKey  String?   @unique @map("dedupe_key")
  digestOnly Boolean   @default(false) @map("digest_only")
  payload    Json      @default("{}")
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notification")
}

model NotificationPreference {
  userId        String   @id @map("user_id") @db.Uuid
  disabledTypes String[] @default([]) @map("disabled_types")
  digestEnabled Boolean  @default(false) @map("digest_enabled")
  channels      Json     @default("{}")
  phoneNumber   String?  @map("phone_number")
  zaloUserId    String?  @map("zalo_user_id")
  timeZone      String   @default("Asia/Bangkok") @map("time_zone")
  quietStart    String?  @map("quiet_start")
  quietEnd      String?  @map("quiet_end")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

model NotificationDelivery {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String                      @map("notification_id") @db.Uuid
  channel           NotificationDeliveryChannel
  status            NotificationDeliveryStatus  @default(pending)
  attempts          Int                         @default(0)
  nextAttemptAt     DateTime                    @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt          DateTime?                   @map("locked_at") @db.Timestamptz(3)
  sentAt            DateTime?                   @map("sent_at") @db.Timestamptz(3)
  providerMessageId String?                     @map("provider_message_id")
  lastError         String?                     @map("last_error")
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_delivery")
}

model BackgroundJobFailure {
