enum ApprovalRequestStatus {
  pending
  approved
  rejected
  changes_requested

  @@map("approval_request_status")
}

model ApprovalFlow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  creatorId   String   @map("creator_id") @db.Uuid
  name        String
  requestType String   @map("request_type")
  steps       Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User              @relation("ApprovalFlowCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  requests ApprovalRequest[]

  @@unique([projectId, requestType, name])
  @@index([projectId, requestType, enabled])
  @@map("approval_flow")
}

model ApprovalRequest {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String                @map("project_id") @db.Uuid
  flowId            String                @map("flow_id") @db.Uuid
  requesterId       String                @map("requester_id") @db.Uuid
  subjectType       String                @map("subject_type")
  subjectId         String                @map("subject_id") @db.Uuid
  currentStep       Int                   @default(0) @map("current_step")
  currentApproverId String?               @map("current_approver_id") @db.Uuid
  status            ApprovalRequestStatus @default(pending)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flow      ApprovalFlow         @relation(fields: [flowId], references: [id], onDelete: Restrict)
  requester User                 @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  results   ApprovalStepResult[]

  @@index([projectId, status, createdAt])
  @@index([subjectType, subjectId])
  @@map("approval_request")
}

model ApprovalStepResult {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId     String   @map("request_id") @db.Uuid
  stepIndex     Int      @map("step_index")
  actorId       String   @map("actor_id") @db.Uuid
  action        String
  note          String?
  delegatedById String?  @map("delegated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User            @relation("ApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, stepIndex, createdAt])
  @@map("approval_step_result")
}

model ApprovalDelegation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grantorId String    @map("grantor_id") @db.Uuid
  granteeId String    @map("grantee_id") @db.Uuid
  projectId String?   @map("project_id") @db.Uuid
  startsAt  DateTime  @map("starts_at") @db.Timestamptz(3)
