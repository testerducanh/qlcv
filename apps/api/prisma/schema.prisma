  @@index([taskId])
  @@index([checklistItemId])
  @@index([commentId])
  @@index([uploaderId])
  @@index([deletedAt])
  @@index([projectId, confirmedAt, createdAt])
  @@index([uploadExpiresAt])
  @@map("attachment")
}

