model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Chỉ lưu băm SHA-256 của refresh token; token thô chưa ban xuất không nằm trong DB.
