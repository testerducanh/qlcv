model Attachment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  taskId           String?   @map("task_id") @db.Uuid
  checklistItemId  String?   @map("checklist_item_id") @db.Uuid
  commentId        String?   @map("comment_id") @db.Uuid
  uploaderId       String    @map("uploader_id") @db.Uuid
  fileName         String    @map("file_name")
  mime             String
  size             Int
  storageKey       String    @map("storage_key")
  uploadStorageKey String?   @map("upload_storage_key")
  thumbKey         String?   @map("thumb_key")
  previewKey       String?   @map("preview_key")
  width            Int?
  height           Int?
  /// Các phiên bản của cùng một tệp dùng chung version_group_id.
  versionGroupId   String    @default(dbgenerated("gen_random_uuid()")) @map("version_group_id") @db.Uuid
