generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUM ============

enum UserStatus {
  active
  invited
  disabled

  @@map("user_status")
}

enum GuestAccessStatus {
  pending_approval
  active
  revoked
  expired

  @@map("guest_access_status")
}

enum NotificationDeliveryChannel {
  email
  zalo
  sms

  @@map("notification_delivery_channel")
}

enum NotificationDeliveryStatus {
  pending
  processing
  sent
  failed

  @@map("notification_delivery_status")
}

enum SystemRole {
  system_admin
  executive
  branch_director
  department_head
  member

  @@map("system_role")
}

enum ProjectStatus {
  active
  on_hold
  completed
  archived

  @@map("project_status")
}

enum ProgressMode {
  by_count
  by_workdays
  manual

  @@map("progress_mode")
}

enum Confidentiality {
  normal
  restricted

  @@map("confidentiality")
}

enum ProjectRole {
  owner
  manager
  member
  restricted
  commenter
  viewer

  @@map("project_role")
}

enum TaskType {
  group
  task
  milestone

  @@map("task_type")
}

enum TaskStatus {
  todo
  doing
  done
  blocked

  @@map("task_status")
}

enum AssignmentLevel {
  light
  standard
  strict

  @@map("assignment_level")
}

enum AssignmentStatus {
  draft
  assigned
  accepted
  in_progress
  pending_review
  done
  rejected
  on_hold

  @@map("assignment_status")
}

enum AssignmentEvidenceRequirement {
  attachment
  note
  either

  @@map("assignment_evidence_requirement")
}

enum AssignmentExtensionStatus {
  pending
  approved
  rejected

  @@map("assignment_extension_status")
}

enum AssignmentAutomationStatus {
  active
  completed
  failed

  @@map("assignment_automation_status")
}

enum TemplateKind {
  project
  task

  @@map("template_kind")
}

enum TemplateOwnership {
  personal
  department
  branch
  company

  @@map("template_ownership")
}

enum TemplateStatus {
  draft
  pending_approval
  published

  @@map("template_status")
}

enum TaskPriority {
  urgent
  high
  normal
  low

  @@map("task_priority")
}

enum CollaboratorRole {
  collaborator
  follower
  approver

  @@map("collaborator_role")
}

enum DependencyType {
  finish_start
  overlap
  blocking_finish

  @@map("dependency_type")
}

enum ViewMode {
  list
  kanban
  timeline
  calendar

  @@map("view_mode")
}

// ============ TỔ CHỨC ============

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches    Branch[]
  departments Department[]
  users       User[]
  labels      Label[]
  templates   Template[]
  apiKeys     IntegrationApiKey[]

  @@map("organization")
}

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  code           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]
  users        User[]
  projects     Project[]
  templates    Template[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@map("branch")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  members      UserDepartment[]
  primaryUsers User[]           @relation("UserPrimaryDepartment")
  templates    Template[]

  @@unique([organizationId, branchId, name])
  @@index([branchId])
  @@map("department")
}

model User {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  email          String     @unique
  name           String
  passwordHash   String?    @map("password_hash")
  status         UserStatus @default(invited)
  systemRole     SystemRole @default(member) @map("system_role")
  branchId       String?    @map("branch_id") @db.Uuid
  departmentId   String?    @map("department_id") @db.Uuid
  lastLoginAt    DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization              Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch                    Branch?                      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department                Department?                  @relation("UserPrimaryDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  departmentLinks           UserDepartment[]
  ownedProjects             Project[]                    @relation("ProjectOwner")
  projectMemberships        ProjectMember[]
  assignedTasks             Task[]                       @relation("TaskAssignee")
  pendingAssignedTasks      Task[]                       @relation("TaskPendingAssignee")
  assignedByTasks           Task[]                       @relation("TaskAssigner")
  reviewedTasks             Task[]                       @relation("TaskReviewer")
  createdTasks              Task[]                       @relation("TaskCreator")
  requestedExtensions       AssignmentExtensionRequest[] @relation("ExtensionRequester")
  decidedExtensions         AssignmentExtensionRequest[] @relation("ExtensionDecider")
  createdMeetings           Meeting[]                    @relation("MeetingCreator")
  assignedMeetingItems      MeetingItem[]                @relation("MeetingItemAssignee")
  createdAutomationRules    AssignmentAutomationRule[]   @relation("AutomationRuleCreator")
  delegationsGiven          ApprovalDelegation[]         @relation("DelegationGrantor")
  delegationsReceived       ApprovalDelegation[]         @relation("DelegationGrantee")
  createdApprovalFlows      ApprovalFlow[]               @relation("ApprovalFlowCreator")
  submittedApprovalRequests ApprovalRequest[]            @relation("ApprovalRequester")
  decidedApprovalSteps      ApprovalStepResult[]         @relation("ApprovalActor")
  taskRoles                 TaskCollaborator[]
  assignedChecklistItems    ChecklistItem[]
  comments                  Comment[]
  mentions                  Mention[]
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  uploads                   Attachment[]
  savedViews                SavedView[]
  activityLogs              ActivityLog[]
  taskAssignmentEvents      TaskAssignmentEvent[]
  refreshTokens             RefreshToken[]
  createdTemplates          Template[]                   @relation("TemplateCreator")
  ownedTemplates            Template[]                   @relation("TemplateOwner")
  createdBaselines          ProjectBaseline[]
  templateVersions          TemplateVersion[]
  templateUses              TemplateUsage[]
  createdTaskRecurrences    TaskRecurrence[]             @relation("TaskRecurrenceCreator")
  invitedGuestAccesses      GuestAccess[]                @relation("GuestAccessInviter")
  createdIntegrationApiKeys IntegrationApiKey[]          @relation("IntegrationApiKeyCreator")

  @@index([organizationId, status])
  @@index([branchId])
  @@index([departmentId])
  @@map("app_user")
}

model UserDepartment {
  userId       String   @map("user_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  isHead       Boolean  @default(false) @map("is_head")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_department")
}

// ============ DỰ ÁN ============

model Project {
  id                        String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId                  String                        @map("branch_id") @db.Uuid
  ownerId                   String                        @map("owner_id") @db.Uuid
  name                      String
  description               String?
  status                    ProjectStatus                 @default(active)
  startDate                 DateTime?                     @map("start_date") @db.Date
  dueDate                   DateTime?                     @map("due_date") @db.Date
  criticalPathEnabled       Boolean                       @default(false) @map("critical_path_enabled")
  autoRescheduleEnabled     Boolean                       @default(false) @map("auto_reschedule_enabled")
  baselineEnabled           Boolean                       @default(false) @map("baseline_enabled")
  membersMayExport          Boolean                       @default(false) @map("members_may_export")
  guestWatermark            Boolean                       @default(true) @map("guest_watermark")
  /// weeklyOff: các thứ nghỉ trong tuần (0 = Chủ nhật, 1 = Thứ Hai, ..., 6 = Thứ Bảy). holidays: danh sách ngày lễ yyyy-MM-dd.
  workCalendar              Json                          @default("{\"weeklyOff\":[0],\"holidays\":[]}") @map("work_calendar")
  progressMode              ProgressMode                  @default(by_workdays) @map("progress_mode")
  confidentiality           Confidentiality               @default(normal)
  assignmentLevel           AssignmentLevel               @default(light) @map("assignment_level")
  strictEvidenceRequirement AssignmentEvidenceRequirement @default(either) @map("strict_evidence_requirement")
  /// Tên trạng thái do dự án đổi, ví dụ {"todo":"Chưa làm"}. Rỗng thì dùng tên mặc định.
  statusLabels              Json                          @default("{}") @map("status_labels")
  customFieldDefinitions    Json                          @default("[]") @map("custom_field_definitions")
  createdAt                 DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                 DateTime?                     @map("deleted_at") @db.Timestamptz(3)

  branch            Branch                       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  owner             User                         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members           ProjectMember[]
  tasks             Task[]
  assignmentEvents  TaskAssignmentEvent[]
  extensionRequests AssignmentExtensionRequest[]
  meetings          Meeting[]
  automationRules   AssignmentAutomationRule[]
  approvalFlows     ApprovalFlow[]
  approvalRequests  ApprovalRequest[]
  labels            Label[]
  attachments       Attachment[]
  savedViews        SavedView[]
  templateUses      TemplateUsage[]
  taskRecurrences   TaskRecurrence[]
  baselines         ProjectBaseline[]
  guestAccesses     GuestAccess[]
  apiKeys           IntegrationApiKey[]

  @@index([branchId, status])
  @@index([ownerId])
  @@index([deletedAt])
  @@map("project")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole @default(member)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_member")
}

// ============ VIỆC ============

model Task {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId          String            @map("project_id") @db.Uuid
  parentId           String?           @map("parent_id") @db.Uuid
  type               TaskType          @default(task)
  /// Chỉ mục phân số, so sánh theo byte (cột được đặt COLLATE "C" trong migration).
  position           String
  /// Do trigger tính từ việc cha: 1 là việc gốc, tối đa 5. Không ghi trực tiếp.
  depth              Int               @default(1) @db.SmallInt
  title              String
  description        String?
  status             TaskStatus        @default(todo)
  assignmentLevel    AssignmentLevel?  @map("assignment_level")
  assignmentStatus   AssignmentStatus? @map("assignment_status")
  blockedReason      String?           @map("blocked_reason")
  priority           TaskPriority      @default(normal)
  startDate          DateTime?         @map("start_date") @db.Date
  durationDays       Int?              @map("duration_days")
  dueDate            DateTime?         @map("due_date") @db.Date
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(3)
  progress           Int               @default(0)
  assigneeId         String?           @map("assignee_id") @db.Uuid
  pendingAssigneeId  String?           @map("pending_assignee_id") @db.Uuid
  reviewerId         String?           @map("reviewer_id") @db.Uuid
  assignerId         String?           @map("assigner_id") @db.Uuid
  handoffNote        String?           @map("handoff_note")
  isGroupAssignment  Boolean           @default(false) @map("is_group_assignment")
  creatorId          String            @map("creator_id") @db.Uuid
  recurrenceSeriesId String?           @map("recurrence_series_id") @db.Uuid
  recurrenceIndex    Int?              @map("recurrence_index")
  customFields       Json              @default("{}") @map("custom_fields")
  /// Khóa lạc quan: ứng dụng tăng 1 mỗi lần sửa.
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(3)

  project           Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent            Task?                        @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Task[]                       @relation("TaskTree")
  assignee          User?                        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  pendingAssignee   User?                        @relation("TaskPendingAssignee", fields: [pendingAssigneeId], references: [id], onDelete: SetNull)
  reviewer          User?                        @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assigner          User?                        @relation("TaskAssigner", fields: [assignerId], references: [id], onDelete: SetNull)
  creator           User                         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  recurrenceSeries  TaskRecurrence?              @relation(fields: [recurrenceSeriesId], references: [id], onDelete: SetNull)
  collaborators     TaskCollaborator[]
  checklistItems    ChecklistItem[]
  labels            TaskLabel[]
  predecessorLinks  TaskDependency[]             @relation("DependencyPredecessor")
  successorLinks    TaskDependency[]             @relation("DependencySuccessor")
  attachments       Attachment[]
  comments          Comment[]
  assignmentEvents  TaskAssignmentEvent[]
  extensionRequests AssignmentExtensionRequest[]
  meetingItems      MeetingItem[]
  guestAccesses     GuestTaskAccess[]

  @@unique([recurrenceSeriesId, recurrenceIndex])
  @@index([projectId, status])
  @@index([assigneeId, dueDate])
  @@index([pendingAssigneeId])
  @@index([reviewerId])
  @@index([parentId, position])
  @@index([recurrenceSeriesId, dueDate])
  @@index([deletedAt])
  @@index([customFields], type: Gin, map: "task_custom_fields_gin")
  @@map("task")
}

model TaskRecurrence {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  rule        Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TaskRecurrenceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks     Task[]

  @@index([projectId, createdAt])
  @@map("task_recurrence")
}

model TaskAssignmentEvent {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String            @map("project_id") @db.Uuid
  taskId       String            @map("task_id") @db.Uuid
  actorId      String            @map("actor_id") @db.Uuid
  action       String
  fromStatus   AssignmentStatus? @map("from_status")
  toStatus     AssignmentStatus? @map("to_status")
  reason       String?
  evidenceNote String?           @map("evidence_note")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
  @@map("task_assignment_event")
}

model AssignmentExtensionRequest {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String                    @map("project_id") @db.Uuid
  taskId           String                    @map("task_id") @db.Uuid
  requesterId      String                    @map("requester_id") @db.Uuid
  requestedDueDate DateTime                  @map("requested_due_date") @db.Date
  taskVersion      Int                       @map("task_version")
  reason           String
  status           AssignmentExtensionStatus @default(pending)
  deciderId        String?                   @map("decider_id") @db.Uuid
  decisionReason   String?                   @map("decision_reason")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt        DateTime?                 @map("decided_at") @db.Timestamptz(3)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requester User    @relation("ExtensionRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  decider   User?   @relation("ExtensionDecider", fields: [deciderId], references: [id], onDelete: SetNull)

  @@index([taskId, status])
  @@index([projectId, createdAt])
  @@map("assignment_extension_request")
}

model TaskCollaborator {
  taskId    String           @map("task_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      CollaboratorRole
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId, role])
  @@index([userId, role])
  @@map("task_collaborator")
}

model ChecklistItem {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String    @map("task_id") @db.Uuid
  title      String
  done       Boolean   @default(false)
  doneAt     DateTime? @map("done_at") @db.Timestamptz(3)
  assigneeId String?   @map("assignee_id") @db.Uuid
  position   String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@unique([taskId, position], map: "checklist_item_position_uq")
  @@index([assigneeId])
  @@map("checklist_item")
}

model Label {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Rỗng: nhãn chuẩn của công ty. Có giá trị: nhãn riêng của dự án.
  projectId      String?  @map("project_id") @db.Uuid
  name           String
  color          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        TaskLabel[]

  @@index([projectId])
  @@map("label")
}

model Template {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  createdById    String            @map("created_by_id") @db.Uuid
  ownerUserId    String?           @map("owner_user_id") @db.Uuid
  departmentId   String?           @map("department_id") @db.Uuid
  branchId       String?           @map("branch_id") @db.Uuid
  name           String
  description    String?
  kind           TemplateKind
  ownership      TemplateOwnership
  tags           String[]          @default([])
  status         TemplateStatus    @default(draft)
  currentVersion Int               @default(1) @map("current_version")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User              @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  ownerUser    User?             @relation("TemplateOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  versions     TemplateVersion[]
  usages       TemplateUsage[]

  @@index([organizationId, ownership, status])
  @@index([createdById, status])
  @@index([branchId, status])
  @@index([departmentId, status])
  @@map("template")
}

model TemplateVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  version     Int
  content     Json
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  template Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  creator  User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  usages   TemplateUsage[]

  @@unique([templateId, version])
  @@index([templateId, createdAt(sort: Desc)])
  @@map("template_version")
}

model TemplateUsage {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId        String   @map("template_id") @db.Uuid
  templateVersionId String   @map("template_version_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  appliedById       String   @map("applied_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  template  Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appliedBy User            @relation(fields: [appliedById], references: [id], onDelete: Restrict)

  @@index([templateId, createdAt(sort: Desc)])
  @@index([projectId])
  @@map("template_usage")
}

model TaskLabel {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_label")
}

model TaskDependency {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  predecessorId  String         @map("predecessor_id") @db.Uuid
  successorId    String         @map("successor_id") @db.Uuid
  type           DependencyType @default(finish_start)
  lagDays        Int            @default(0) @map("lag_days")
  autoReschedule Boolean        @default(false) @map("auto_reschedule")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

