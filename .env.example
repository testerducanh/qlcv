# ---- Hạ tầng Docker (đổi cổng nếu máy bạn đang bị trùng) ----
POSTGRES_USER=qlcv
POSTGRES_PASSWORD=qlcv_dev_password
POSTGRES_DB=qlcv
POSTGRES_PORT=5433
REDIS_PORT=6379
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=QLCVDEVKEY001
S3_SECRET_KEY=qlcv_dev_secret_change_me
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- API đọc các biến này ----
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://qlcv:qlcv_dev_password@localhost:5433/qlcv
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# S3_ACCESS_KEY và S3_SECRET_KEY khai báo một lần ở khối hạ tầng phía trên, dùng chung cho cả RustFS và API.
S3_BUCKET=qlcv-files
S3_FORCE_PATH_STYLE=true
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT=1mb

