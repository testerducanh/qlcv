# ---- Hạ tầng Docker (đổi cổng nếu máy bạn đang bị trùng) ----
POSTGRES_USER=qlcv
POSTGRES_PASSWORD=qlcv_dev_password
POSTGRES_DB=qlcv
POSTGRES_PORT=5433
REDIS_PORT=6379
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=QLCVDEVKEY001
S3_SECRET_KEY=qlcv_dev_secret_change_me
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- API đọc các biến này ----
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://qlcv:qlcv_dev_password@localhost:5433/qlcv
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
WEB_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@qlcv.local
SMTP_SECURE=false
# SMTP_USER and SMTP_PASSWORD are optional for local Mailpit.
NOTIFICATION_DAILY_MESSAGE_LIMIT=1000
# Zalo and SMS are mock-only adapters until an approved business provider is configured.
# Required to enable /health/operations and ops-monitor; use a random 32+ character secret.
OPS_MONITOR_TOKEN=
OPS_QUEUE_BACKLOG_LIMIT=500
# Configure these only on the independent monitoring host.
OPS_ALERT_EMAIL=
OPS_API_URL=http://127.0.0.1:3000/health/operations
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# S3_ACCESS_KEY và S3_SECRET_KEY khai báo một lần ở khối hạ tầng phía trên, dùng chung cho cả RustFS và API.
S3_BUCKET=qlcv-files
S3_FORCE_PATH_STYLE=true
ATTACHMENT_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
ATTACHMENT_MAX_FILE_BYTES=26214400
ATTACHMENT_MAX_PER_TASK=100
ATTACHMENT_PROJECT_QUOTA_BYTES=5368709120
ATTACHMENT_ORGANIZATION_QUOTA_BYTES=107374182400
ATTACHMENT_UPLOAD_URL_SECONDS=300
ATTACHMENT_DOWNLOAD_URL_SECONDS=120
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT=1mb
